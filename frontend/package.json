{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:tokens": "node scripts/lint-tokens.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "e2e:update": "playwright test e2e/aurora-visual.spec.ts --update-snapshots",
    "start:standalone": "cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/ && PORT=${PORT:-3000} HOSTNAME=0.0.0.0 node .next/standalone/server.js",
    "e2e:record": "node e2e/record.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@dagrejs/dagre": "^1.1.8",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/d3": "^7.4.3",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.48.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "shadcn": "^4.0.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
