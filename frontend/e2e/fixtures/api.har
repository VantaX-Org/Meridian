tus":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-type","value":"application/json"}],"content":{"size":-1,"mimeType":"application/json","text":"{\"current_version\":\"0.0.0-dev\",\"latest_version\":\"0.0.0-dev\",\"update_available\":false,\"release_notes\":\"\",\"updater_configured\":false}"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":6.54}},{"startedDateTime":"2026-10-02T17:21:20.582Z","time":2.52,"request":{"method":"GET","url":"http://localhost:3000/api/v1/findings?limit=200&offset=0","httpVersion":"HTTP/1.1","cookies":[],"headers":[],"queryString":[{"name":"limit","value":"200"},{"name":"offset","value":"0"}],"headersSize":-1,"bodySize":-1},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"content-type","value":"application/json"}],"content":{"size":-1,"mimeType":"application/json","text":"{\"findings\":[{\"id\":\"6d7b0459-08ca-4b11-90aa-c0524ae19064\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"XREC001\",\"severity\":\"critical\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Reconciliation account is not a vendor reconciliation account in this company code\",\"semantics\":\"fail_when\",\"expression\":\"`SKB1.MITKZ`.isna() | (`SKB1.MITKZ` != 'K')\",\"field_checked\":\"LFB1.AKONT\",\"id_field_used\":\"LFB1.LIFNR\",\"fields_checked\":[\"LFB1.AKONT\",\"SKB1.MITKZ\",\"SKB1.MITKZ\"],\"record_key_fields\":[\"LFB1.LIFNR\",\"LFB1.BUKRS\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFB1.AKONT\":\"0000113100\",\"LFB1.BUKRS\":\"1000\",\"LFB1.LIFNR\":\"V3\",\"SKB1.MITKZ\":\"\",\"record_key\":\"LIFNR=V3|BUKRS=1000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Postings fail or land on the wrong G/L account; the vendor sub-ledger does not reconcile to the G/L.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"Every posting to the vendor is mirrored to LFB1.AKONT in the general ledger. SAP checks the account type on entry, but loaded or migrated records can point to an account that is missing in the company code or is not a vendor reconciliation account (SKB1.MITKZ = 'K'), so the sub-ledger no longer reconciles.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFB1.LIFNR\",\"record_id\":\"V3\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor company-code record 1000: reconciliation account 0000113100 is not a vendor reconciliation account.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"7ce931f3-6616-41e6-8cfb-e90930b8e4f5\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP083\",\"severity\":\"critical\",\"dimension\":\"uniqueness\",\"affected_count\":2,\"total_count\":14,\"pass_rate\":85.71,\"details\":{\"message\":\"Possible duplicate vendor invoice: same vendor, reference, amount and currency still open\",\"field_checked\":\"BSIK.XBLNR\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.XBLNR\",\"BSIK.WRBTR\",\"BSIK.WAERS\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":2,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000118\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V2\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.WAERS\":\"EUR\",\"BSIK.WRBTR\":\"2380.00\",\"BSIK.XBLNR\":\"INV-1001\",\"BSIK.ZUONR\":\"INV-1001\",\"record_key\":\"BUKRS=1000|LIFNR=V2|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=INV-1001|GJAHR=2026|BELNR=5100000118|BUZEI=001\"},{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000119\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V2\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.WAERS\":\"EUR\",\"BSIK.WRBTR\":\"2380.00\",\"BSIK.XBLNR\":\"INV1001\",\"BSIK.ZUONR\":\"INV1001\",\"record_key\":\"BUKRS=1000|LIFNR=V2|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=INV1001|GJAHR=2026|BELNR=5100000119|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Both invoices are paid by the next payment run: a direct cash loss that has to be recovered from the vendor.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"Two open invoices from one vendor with the same reference and amount are almost always the same invoice entered twice. SAP's own duplicate-invoice check compares the reference exactly, so 'INV-1001' and 'INV1001' slip through; this check ignores spaces, dashes and punctuation.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Invoice 5100000118/2026 of vendor V2: reference INV-1001, 2380.00 EUR is open more than once.\"},{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Invoice 5100000119/2026 of vendor V2: reference INV1001, 2380.00 EUR is open more than once.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"e135b967-d1ab-48b7-9246-e759b2b3cd90\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP010\",\"severity\":\"critical\",\"dimension\":\"completeness\",\"affected_count\":0,\"total_count\":6,\"pass_rate\":100.0,\"details\":{\"message\":\"Vendor account group is mandatory — controls field status and number range\",\"field_checked\"