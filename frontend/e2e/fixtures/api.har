le_context\":{},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"8a11c96f-3699-42da-a677-d323c605778f\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP024\",\"severity\":\"critical\",\"dimension\":\"consistency\",\"affected_count\":0,\"total_count\":6,\"pass_rate\":100.0,\"details\":{\"message\":\"Vendor with bank country must have complete bank details (bank key + account number)\",\"semantics\":\"fail_when\",\"expression\":\"`LFBK.BANKS`.notna() & (`LFBK.BANKL`.isna() | `LFBK.BANKN`.isna())\",\"field_checked\":\"LFA1.LIFNR\",\"id_field_used\":\"LFA1.LIFNR\",\"fields_checked\":[\"LFA1.LIFNR\",\"LFBK.BANKS\",\"LFBK.BANKL\",\"LFBK.BANKN\"],\"record_key_fields\":[\"LFA1.LIFNR\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":0,\"sample_failing_records\":[]},\"remediation_text\":null,\"rule_context\":{},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"0f53fb01-6a88-41e2-95af-8c7d9235efd3\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP025\",\"severity\":\"critical\",\"dimension\":\"uniqueness\",\"affected_count\":0,\"total_count\":6,\"pass_rate\":100.0,\"details\":{\"message\":\"Duplicate vendor numbers detected — each vendor must be unique\",\"field_checked\":\"LFA1.LIFNR\",\"id_field_used\":\"LFA1.LIFNR\",\"fields_checked\":[\"LFA1.LIFNR\"],\"record_key_fields\":[\"LFA1.LIFNR\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":0,\"sample_failing_records\":[]},\"remediation_text\":null,\"rule_context\":{},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"22fffc2a-87a2-42ea-ba98-06f640825f95\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"XDUP003\",\"severity\":\"high\",\"dimension\":\"uniqueness\",\"affected_count\":2,\"total_count\":5,\"pass_rate\":60.0,\"details\":{\"message\":\"The same bank account is maintained for several vendors\",\"field_checked\":\"LFBK.BANKN\",\"id_field_used\":\"LFBK.LIFNR\",\"fields_checked\":[\"LFBK.BANKS\",\"LFBK.BANKL\",\"LFBK.BANKN\"],\"record_key_fields\":[\"LFBK.LIFNR\",\"LFBK.BANKS\",\"LFBK.BANKL\",\"LFBK.BANKN\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":2,\"sample_failing_records\":[{\"LFBK.BANKL\":\"632005\",\"LFBK.BANKN\":\"4055555555\",\"LFBK.BANKS\":\"ZA\",\"LFBK.LIFNR\":\"V4\",\"record_key\":\"LIFNR=V4|BANKS=ZA|BANKL=632005|BANKN=4055555555\"},{\"LFBK.BANKL\":\"632005\",\"LFBK.BANKN\":\"4055555555\",\"LFBK.BANKS\":\"ZA\",\"LFBK.LIFNR\":\"V5\",\"record_key\":\"LIFNR=V5|BANKS=ZA|BANKL=632005|BANKN=4055555555\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Payments for different vendors land in one account; classic payment-redirection fraud pattern.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"Payments to one bank account from several vendor accounts are either a duplicate vendor or a payment-fraud pattern (a changed bank account pointing to another vendor's or an employee's account). Every occurrence must be explained.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFBK.LIFNR\",\"record_id\":\"V4\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Record ZA shares LFBK.BANKS, LFBK.BANKL, LFBK.BANKN with another record.\"},{\"id_field\":\"LFBK.LIFNR\",\"record_id\":\"V5\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Record ZA shares LFBK.BANKS, LFBK.BANKL, LFBK.BANKN with another record.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"6eab4643-683a-4f7f-a8bb-0ae6de131092\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"BX-BNKA\",\"severity\":\"high\",\"dimension\":\"accuracy\",\"affected_count\":1,\"total_count\":5,\"pass_rate\":80.0,\"details\":{\"message\":\"SWIFT/BIC (BNKA.SWIFT) is not in the SWIFT directory loaded for its country\",\"reference\":\"REF_BIC\",\"field_checked\":\"BNKA.SWIFT\",\"id_field_used\":\"BNKA.BANKS\",\"record_key_fields\":[\"BNKA.BANKS\",\"BNKA.BANKL\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BNKA.BANKL\":\"632006\",\"BNKA.BANKS\":\"ZA\",\"BNKA.SWIFT\":\"ZZZZZAJJ\",\"record_key\":\"BANKS=ZA|BANKL=632006\",\"invalid_value\":\"ZZZZZAJJ\"}],\"distinct_invalid_values\":{\"ZZZZZAJJ\":1}},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Payments to every vendor and customer of this bank are rejected or returned.\",\"rule_authority\":\"customer_reference_data\",\"why_it_matters\":\"A well-formed BIC can still belong to no bank, or to a closed one. Payment media carry it unchanged and the bank rejects the transfer. Judged only for countries the loaded directory covers.\"},\"value_fix_map\":{\"ZZZZZAJJ\":{\"invalid_value\":\"ZZZZZAJJ\",\"sql_statement\":null,\"fix_instruction\":\"Look the bank up in the SWIFT directory and correct the BIC in the bank directory (FI02).\",\"suggested_value\":null}},\"record_fixes\":[{\"id_field\":\"BNKA.BANKS\",\"record_id\":\"ZA\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Bank ZA/632006: BIC ZZZZZAJJ is not in the SWIFT directory.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"7e459214-4aed-4c81-bc03-a9bb5c86b071\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP063\",\"severity\":\"high\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Vendor reconciliation account is blocked for posting or flagged for deletion in the company code\",\"semantics\":\"fail_when\",\"expression\":\"(`SKB1.XSPEB` == 'X') | (`SKB1.XLOEB` == 'X')\",\"field_checked\":\"LFB1.AKONT\",\"id_field_used\":\"LFB1.LIFNR\",\"fields_checked\":[\"LFB1.AKONT\",\"SKB1.XSPEB\",\"SKB1.XLOEB\"],\"record_key_fields\":[\"LFB1.LIFNR\",\"LFB1.BUKRS\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFB1.AKONT\":\"0000113100\",\"LFB1.BUKRS\":\"1000\",\"LFB1.LIFNR\":\"V3\",\"SKB1.XLOEB\":\"\",\"SKB1.XSPEB\":\"X\",\"record_key\":\"LIFNR=V3|BUKRS=1000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"MIRO, FB60 and F110 fail with 'account blocked for posting'; the vendor cannot be invoiced or paid in this company code.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"Every posting to the vendor is also posted to its reconciliation account. When that G/L account is blocked for posting (SKB1.XSPEB) or flagged for deletion (SKB1.XLOEB) in the company code, SAP rejects every invoice, credit memo and payment for the vendor.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFB1.LIFNR\",\"record_id\":\"V3\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor V3, company code 1000: reconciliation account 0000113100 is blocked or flagged for deletion.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"8c2373d4-f1d3-4e59-bc6e-f94b826a616d\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP016\",\"severity\":\"high\",\"dimension\":\"completeness\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Payment terms missing — invoice due date defaults to immediate\",\"field_checked\":\"LFB1.ZTERM\",\"id_field_used\":\"LFB1.LIFNR\",\"record_key_fields\":[\"LFB1.LIFNR\",\"LFB1.BUKRS\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFB1.BUKRS\":\"1000\",\"LFB1.LIFNR\":\"V3\",\"LFB1.ZTERM\":\"\",\"record_key\":\"LIFNR=V3|BUKRS=1000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Invoice due date defaults to immediate payment. Early payment discounts (cash discount conditions) are not captured. Cash flow forecasting in FF7A is inaccurate.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"ZTERM (payment terms) determines when an invoice is due and what early payment discounts are available. Without payment terms, all invoices default to immediate payment — the vendor receives no standard payment period and the company cannot capture early payment discounts via F110.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFB1.LIFNR\",\"record_id\":\"V3\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor {LFA1.LIFNR}: ZTERM is . Set payment terms via FK02 / Fiori app F3893.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"a3fd2929-8a21-4a04-8bb8-de6abc87b369\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP042\",\"severity\":\"high\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Purchasing payment terms LFM1.ZTERM must exist in T052\",\"field_checked\":\"LFM1.ZTERM\",\"id_field_used\":\"LFM1.LIFNR\",\"missing_values\":[\"9999\"],\"reference_field\":\"LFM1.ZTERM\",\"reference_table\":\"T052.ZTERM\",\"reference_source\":\"live_config\",\"record_key_fields\":[\"LFM1.LIFNR\",\"LFM1.EKORG\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFM1.EKORG\":\"1000\",\"LFM1.LIFNR\":\"V5\",\"LFM1.ZTERM\":\"9999\",\"record_key\":\"LIFNR=V5|EKORG=1000\",\"invalid_value\":\"9999\"}],\"distinct_invalid_values\":{\"9999\":1}},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Invoices referencing these POs get no due date; F110 pays them immediately or not at all.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"Purchasing payment terms are copied into every PO and from there into the invoice (MIRO). Terms that are not defined in T052 leave the invoice without a baseline date and due date.\"},\"value_fix_map\":{\"9999\":{\"invalid_value\":\"9999\",\"sql_statement\":null,\"fix_instruction\":\"Payment terms '9999' are not defined in T052. Correct them in XK02/MK02 or create the terms (OBB8).\",\"suggested_value\":null}},\"record_fixes\":[{\"id_field\":\"LFM1.LIFNR\",\"record_id\":\"V5\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor V5, purchasing organisation 1000: payment terms '' not in T052.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"4df348e2-a535-4f41-966b-683804a9c8cf\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP040\",\"severity\":\"high\",\"dimension\":\"completeness\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Order currency is missing in the vendor's purchasing-organisation data\",\"field_checked\":\"LFM1.WAERS\",\"id_field_used\":\"LFM1.LIFNR\",\"record_key_fields\":[\"LFM1.LIFNR\",\"LFM1.EKORG\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFM1.EKORG\":\"1000\",\"LFM1.LIFNR\":\"V4\",\"LFM1.WAERS\":\"\",\"record_key\":\"LIFNR=V4|EKORG=1000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"ME21N proposes no currency for this vendor; automatic PO creation from requisitions (ME59N) fails for the purchasing organisation.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"LFM1.WAERS is a required entry of the vendor purchasing view (XK01/MK01; BP role FLVN01 in S/4HANA): every purchase order, contract and scheduling agreement for this purchasing organisation takes its currency from it. A record without it was loaded around the screen checks (LSMW, direct input, migration).\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFM1.LIFNR\",\"record_id\":\"V4\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor V4, purchasing organisation 1000: order currency is .\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"53b63d71-3adc-48e1-b9c6-77a48645ba5a\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP081\",\"severity\":\"high\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Cleared vendor item was cleared before it was posted\",\"semantics\":\"fail_when\",\"expression\":\"`BSAK.AUGDT` < `BSAK.BUDAT`\",\"field_checked\":\"BSAK.AUGDT\",\"id_field_used\":\"BSAK.BUKRS\",\"fields_checked\":[\"BSAK.AUGDT\",\"BSAK.BUDAT\"],\"record_key_fields\":[\"BSAK.BUKRS\",\"BSAK.LIFNR\",\"BSAK.UMSKS\",\"BSAK.UMSKZ\",\"BSAK.AUGDT\",\"BSAK.AUGBL\",\"BSAK.ZUONR\",\"BSAK.GJAHR\",\"BSAK.BELNR\",\"BSAK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSAK.AUGBL\":\"1500000211\",\"BSAK.AUGDT\":\"20260818\",\"BSAK.BELNR\":\"5100000093\",\"BSAK.BUDAT\":\"20260820\",\"BSAK.BUKRS\":\"1000\",\"BSAK.BUZEI\":\"001\",\"BSAK.GJAHR\":\"2026\",\"BSAK.LIFNR\":\"V1\",\"BSAK.UMSKS\":\"\",\"BSAK.UMSKZ\":\"\",\"BSAK.ZUONR\":\"\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=20260818|AUGBL=1500000211|ZUONR=|GJAHR=2026|BELNR=5100000093|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Key-date open-item lists (as of a date between the two) omit an item that was open; ageing and payment-behaviour analysis are wrong.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"An item can only be cleared on or after its posting date. A clearing date before the posting date means the clearing was back-dated incorrectly or the item data is corrupt.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSAK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Cleared item 1000/V1 document 5100000093/2026 item 001: cleared 20260818, posted 20260820.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"636791dd-924c-4b07-93ec-45d261b4072b\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP082\",\"severity\":\"high\",\"dimension\":\"completeness\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Cleared vendor item has no clearing document or clearing date\",\"semantics\":\"fail_when\",\"expression\":\"`BSAK.AUGBL`.isna() | `BSAK.AUGDT`.isna()\",\"field_checked\":\"BSAK.AUGBL\",\"id_field_used\":\"BSAK.BUKRS\",\"fields_checked\":[\"BSAK.AUGBL\",\"BSAK.AUGDT\"],\"record_key_fields\":[\"BSAK.BUKRS\",\"BSAK.LIFNR\",\"BSAK.UMSKS\",\"BSAK.UMSKZ\",\"BSAK.AUGDT\",\"BSAK.AUGBL\",\"BSAK.ZUONR\",\"BSAK.GJAHR\",\"BSAK.BELNR\",\"BSAK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSAK.AUGBL\":\"\",\"BSAK.AUGDT\":\"00000000\",\"BSAK.BELNR\":\"5100000094\",\"BSAK.BUKRS\":\"1000\",\"BSAK.BUZEI\":\"001\",\"BSAK.GJAHR\":\"2026\",\"BSAK.LIFNR\":\"V1\",\"BSAK.UMSKS\":\"\",\"BSAK.UMSKZ\":\"\",\"BSAK.ZUONR\":\"\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=|GJAHR=2026|BELNR=5100000094|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"The item is neither open nor traceably cleared: the audit trail from invoice to payment breaks.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"BSAK holds CLEARED items only; each carries the clearing document and date. A row without them cannot be traced to the payment or clearing that settled it.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSAK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Cleared item 1000/V1 document 5100000094/2026 item 001 has no clearing reference.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"6fdad596-9f24-4a48-9085-0511ec9e1b89\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP075\",\"severity\":\"high\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":18,\"pass_rate\":94.44,\"details\":{\"message\":\"Open item on a vendor flagged for deletion\",\"semantics\":\"fail_when\",\"expression\":\"(`LFA1.LOEVM` == 'X') | (`LFB1.LOEVM` == 'X')\",\"field_checked\":\"LFA1.LOEVM\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"LFA1.LOEVM\",\"LFB1.LOEVM\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000113\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V6\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.ZUONR\":\"TX-55120\",\"LFA1.LOEVM\":\"X\",\"LFB1.LOEVM\":\"\",\"record_key\":\"BUKRS=1000|LIFNR=V6|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=TX-55120|GJAHR=2026|BELNR=5100000113|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Archiving of the vendor fails; outstanding liabilities or receivables sit on a dead account.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"A vendor marked for deletion is meant to be finished with. Open items on it are still owed or receivable: they will not be archived, are easily overlooked in reviews of active accounts, and payments or dunning may be blocked by the deletion flag.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V6 document 5100000113/2026 item 001: the vendor is flagged for deletion.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"b4af7e0f-0b5a-4c7d-8ec7-1064b8f7efd1\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP073\",\"severity\":\"high\",\"dimension\":\"accuracy\",\"affected_count\":1,\"total_count\":18,\"pass_rate\":94.44,\"details\":{\"message\":\"Open vendor item has a document-currency amount but zero in company-code currency\",\"semantics\":\"fail_when\",\"expression\":\"(`BSIK.DMBTR` == 0) & (`BSIK.WRBTR` != 0)\",\"field_checked\":\"BSIK.DMBTR\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"BSIK.DMBTR\",\"BSIK.WRBTR\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000111\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.DMBTR\":\"0.00\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V2\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.WRBTR\":\"1190.00\",\"BSIK.ZUONR\":\"RE-2026-0902\",\"record_key\":\"BUKRS=1000|LIFNR=V2|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=RE-2026-0902|GJAHR=2026|BELNR=5100000111|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"The sub-ledger and G/L balance in local currency understate the item; foreign-currency valuation (FAGL_FCV) and payment proposal amounts are wrong.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"Every posted line item is translated into company-code currency. A zero local amount against a non-zero document amount means the translation failed (missing exchange rate, manual override), so the item is worth nothing in the ledger.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V2 document 5100000111/2026 item 001: amount 1190.00 {BSIK.WAERS} translates to 0.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"58a32012-7dd4-4dee-b360-bd6f4c5e15fb\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP077\",\"severity\":\"high\",\"dimension\":\"validity\",\"affected_count\":1,\"total_count\":18,\"pass_rate\":94.44,\"details\":{\"message\":\"Open vendor item stores a negative amount\",\"semantics\":\"fail_when\",\"expression\":\"(`BSIK.DMBTR` < 0) | (`BSIK.WRBTR` < 0)\",\"field_checked\":\"BSIK.DMBTR\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"BSIK.DMBTR\",\"BSIK.WRBTR\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000115\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.DMBTR\":\"920.00-\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.WRBTR\":\"920.00-\",\"BSIK.ZUONR\":\"SI-78013\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=SI-78013|GJAHR=2026|BELNR=5100000115|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Balances, payment proposals and ageing net the item the wrong way.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"SAP stores line-item amounts unsigned; the debit/credit indicator (SHKZG) carries the sign. A negative stored amount double-negates the item in every total.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V1 document 5100000115/2026 item 001 stores a negative amount.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"ff31cb86-330d-464a-a56c-2f286fe53de7\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP072\",\"severity\":\"high\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":18,\"pass_rate\":94.44,\"details\":{\"message\":\"Open vendor item carries a clearing document or clearing date\",\"semantics\":\"fail_when\",\"expression\":\"`BSIK.AUGBL`.notna() | `BSIK.AUGDT`.notna()\",\"field_checked\":\"BSIK.AUGBL\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"BSIK.AUGBL\",\"BSIK.AUGDT\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"1500000220\",\"BSIK.AUGDT\":\"20260915\",\"BSIK.BELNR\":\"5100000110\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.ZUONR\":\"SI-78001\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=20260915|AUGBL=1500000220|ZUONR=SI-78001|GJAHR=2026|BELNR=5100000110|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"The item can be paid or dunned again although it is cleared, or never shows in FBL1N.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"BSIK is the secondary index of OPEN vendor items; when an item is cleared SAP moves it to BSAK. An open-item row with clearing data means the index and the line item disagree, so the open-item list (FBL1N) and the account balance no longer match.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V1 document 5100000110/2026 item 001 carries clearing data.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"9fa0474d-e128-4a33-be17-166152dc4fda\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"XDUP001\",\"severity\":\"high\",\"dimension\":\"uniqueness\",\"affected_count\":0,\"total_count\":1,\"pass_rate\":100.0,\"details\":{\"message\":\"Several vendors share the same VAT registration number\",\"field_checked\":\"LFA1.STCEG\",\"id_field_used\":\"LFB1.LIFNR\",\"fields_checked\":[\"LFA1.STCEG\",\"LFB1.BUKRS\"],\"record_key_fields\":[\"LFB1.LIFNR\",\"LFB1.BUKRS\"],\"population_excluded\":{\"deleted\":1,\"one_time_account\":1},\"failing_record_count\":0,\"sample_failing_records\":[]},\"remediation_text\":null,\"rule_context\":{},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"8fed9a68-09bf-4fe2-a6e0-cc48836c8ed2\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP011\",\"severity\":\"high\",\"dimension\":\"validity\",\"affected_count\":0,\"total_count\":1,\"pass_rate\":100.0,\"details\":{\"format\":null,\"message\":\"Central deletion flag must be X (marked) or empty (active)\",\"field_checked\":\"