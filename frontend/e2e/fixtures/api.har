DIC-LFM1-LENGTH\",\"severity\":\"high\",\"dimension\":\"validity\",\"affected_count\":0,\"total_count\":60,\"pass_rate\":100.0,\"details\":{\"kind\":\"length\",\"table\":\"LFM1\",\"fields_failing\":{},\"record_key_fields\":[\"LFM1.LIFNR\",\"LFM1.EKORG\"],\"failing_record_count\":0,\"dictionary_provenance\":[\"sap_standard\"],\"sample_failing_records\":[]},\"remediation_text\":null,\"rule_context\":{},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"81824bcc-59a5-4f38-a8c7-b7d9daf49035\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP059\",\"severity\":\"medium\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":1,\"pass_rate\":0.0,\"details\":{\"message\":\"Clearing with customer is switched on but the vendor is not linked to a customer\",\"semantics\":\"fail_when\",\"expression\":\"`LFA1.KUNNR`.isna()\",\"field_checked\":\"LFB1.XVERR\",\"id_field_used\":\"LFB1.LIFNR\",\"fields_checked\":[\"LFB1.XVERR\",\"LFA1.KUNNR\"],\"record_key_fields\":[\"LFB1.LIFNR\",\"LFB1.BUKRS\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFA1.KUNNR\":\"\",\"LFB1.BUKRS\":\"1000\",\"LFB1.LIFNR\":\"V5\",\"LFB1.XVERR\":\"X\",\"record_key\":\"LIFNR=V5|BUKRS=1000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"The payment program pays the vendor in full although the partner owes receivables; netting agreed with the partner does not happen.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"Offsetting a vendor's payables against the same partner's receivables (F110, dunning) needs both the 'clearing with customer' indicator (LFB1.XVERR) and the customer number in the vendor's control data (LFA1.KUNNR). With the indicator alone nothing is offset.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFB1.LIFNR\",\"record_id\":\"V5\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor V5, company code 1000: clearing with customer is set but no customer is linked.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"18909056-f04c-453c-85da-94c0a4527d91\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"VP-LFA1-NAME2\",\"severity\":\"medium\",\"dimension\":\"validity\",\"affected_count\":1,\"total_count\":1,\"pass_rate\":0.0,\"details\":{\"message\":\"Name 2 (LFA1.NAME2) holds data that belongs in another field\",\"detected\":{\"email\":1},\"belongs_in\":{\"email\":\"the e-mail address (ADR6.SMTP_ADDR — address data, communication tab)\"},\"field_checked\":\"LFA1.NAME2\",\"id_field_used\":\"LFA1.LIFNR\",\"record_key_fields\":[\"LFA1.LIFNR\"],\"population_excluded\":{\"deleted\":1,\"one_time_account\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFA1.LIFNR\":\"V3\",\"LFA1.NAME2\":\"ap@gamma.co.za\",\"record_key\":\"LIFNR=V3\",\"invalid_value\":\"ap@gamma.co.za\"}],\"distinct_invalid_values\":{\"ap@gamma.co.za\":1}},\"remediation_text\":null,\"rule_context\":{\"rule_authority\":\"generated_value_placement\",\"why_it_matters\":\"Data in the wrong field is invisible to every process that reads the right one: dunning e-mails, payment files, tax reports and duplicate checks miss it.\"},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"0fbd27d4-ee36-4844-bf9f-fd690b91e2ea\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP079\",\"severity\":\"medium\",\"dimension\":\"validity\",\"affected_count\":1,\"total_count\":2,\"pass_rate\":50.0,\"details\":{\"message\":\"Open vendor item's payment block reason is not defined (T008)\",\"field_checked\":\"BSIK.ZLSPR\",\"id_field_used\":\"BSIK.BUKRS\",\"missing_values\":[\"Z\"],\"reference_field\":\"BSIK.ZLSPR\",\"reference_table\":\"T008.ZAHLS\",\"reference_source\":\"live_config\",\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000117\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.ZLSPR\":\"Z\",\"BSIK.ZUONR\":\"SI-78023\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=SI-78023|GJAHR=2026|BELNR=5100000117|BUZEI=001\",\"invalid_value\":\"Z\"}],\"distinct_invalid_values\":{\"Z\":1}},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"The item is excluded from every payment run until someone notices and edits it.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"A payment block reason that is not configured cannot be released through the normal workflow and is not explained to whoever reviews the block.\"},\"value_fix_map\":{\"Z\":{\"invalid_value\":\"Z\",\"sql_statement\":null,\"fix_instruction\":\"Replace the block reason with one defined in T008 (OB27), or release the block.\",\"suggested_value\":null}},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V1 document 5100000117/2026 item 001: payment block '' is not defined.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"2f404b59-6384-48fc-a68f-75c0b99831d6\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP080\",\"severity\":\"medium\",\"dimension\":\"validity\",\"affected_count\":1,\"total_count\":3,\"pass_rate\":66.67,\"details\":{\"message\":\"Open vendor item's special G/L indicator is not defined (T074U)\",\"field_checked\":\"BSIK.UMSKZ\",\"id_field_used\":\"BSIK.BUKRS\",\"missing_values\":[\"Q\"],\"reference_field\":\"BSIK.UMSKZ\",\"reference_table\":\"T074U.UMSKZ\",\"reference_source\":\"live_config\",\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"1700000013\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"Q\",\"BSIK.ZUONR\":\"BG-2026-01\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=Q|AUGDT=00000000|AUGBL=|ZUONR=BG-2026-01|GJAHR=2026|BELNR=1700000013|BUZEI=001\",\"invalid_value\":\"Q\"}],\"distinct_invalid_values\":{\"Q\":1}},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"The item cannot be cleared through the special G/L transactions; balance-sheet classification is wrong.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"The special G/L indicator decides the alternative reconciliation account (down payments, guarantees, bills of exchange). One that is not configured has no account determination.\"},\"value_fix_map\":{\"Q\":{\"invalid_value\":\"Q\",\"sql_statement\":null,\"fix_instruction\":\"Configure the indicator (OBYR / T074U) or repost the item without it.\",\"suggested_value\":null}},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V1 document 1700000013/2026 item 001: special G/L indicator '' is not defined.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"f81f38b3-e028-43bf-ace2-ffb6e5df3cc4\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP066\",\"severity\":\"medium\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":5,\"pass_rate\":80.0,\"details\":{\"message\":\"Bank details validity starts after it ends\",\"semantics\":\"fail_when\",\"expression\":\"`LFBK.KOVON` > `LFBK.KOBIS`\",\"field_checked\":\"LFBK.KOVON\",\"id_field_used\":\"LFBK.LIFNR\",\"fields_checked\":[\"LFBK.KOVON\",\"LFBK.KOBIS\"],\"record_key_fields\":[\"LFBK.LIFNR\",\"LFBK.BANKS\",\"LFBK.BANKL\",\"LFBK.BANKN\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFBK.BANKL\":\"60050101\",\"LFBK.BANKN\":\"0532013000\",\"LFBK.BANKS\":\"DE\",\"LFBK.KOBIS\":\"20241231\",\"LFBK.KOVON\":\"20250101\",\"LFBK.LIFNR\":\"V2\",\"record_key\":\"LIFNR=V2|BANKS=DE|BANKL=60050101|BANKN=0532013000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"F110 finds no valid bank details for the vendor and leaves the items as exceptions.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"Bank details are used for payment only inside their validity period (KOVON-KOBIS). A period that ends before it starts is never valid, so the bank account is silently unusable.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFBK.LIFNR\",\"record_id\":\"V2\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor V2: bank details valid from 20250101 to 20241231.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"462c3956-248c-48a8-b1e2-50d834832a9f\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"PX-LFA1-PSTLZ\",\"severity\":\"medium\",\"dimension\":\"accuracy\",\"affected_count\":1,\"total_count\":5,\"pass_rate\":80.0,\"details\":{\"message\":\"Postal code (LFA1.PSTLZ) is not in the official postal code list for its country\",\"reference\":\"REF_POSTAL\",\"field_checked\":\"LFA1.PSTLZ\",\"id_field_used\":\"LFA1.LIFNR\",\"record_key_fields\":[\"LFA1.LIFNR\"],\"population_excluded\":{\"deleted\":1,\"one_time_account\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFA1.LAND1\":\"ZA\",\"LFA1.LIFNR\":\"V5\",\"LFA1.PSTLZ\":\"0002\",\"record_key\":\"LIFNR=V5\",\"invalid_value\":\"0002\"}],\"distinct_invalid_values\":{\"0002\":1}},\"remediation_text\":null,\"rule_context\":{\"rule_authority\":\"customer_reference_data\",\"why_it_matters\":\"A postal code that does not exist cannot be delivered to and puts the address in the wrong tax jurisdiction and carrier zone. Judged only for countries whose official list is loaded.\"},\"value_fix_map\":{},\"record_fixes\":[],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"6ab5bd46-b82b-4e08-920d-2fe3b1e9da88\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP044\",\"severity\":\"medium\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":6,\"pass_rate\":83.33,\"details\":{\"message\":\"Incoterms location is maintained without an Incoterm\",\"semantics\":\"fail_when\",\"expression\":\"`LFM1.INCO2`.notna() & `LFM1.INCO1`.isna()\",\"field_checked\":\"LFM1.INCO2\",\"id_field_used\":\"LFM1.LIFNR\",\"fields_checked\":[\"LFM1.INCO2\",\"LFM1.INCO1\"],\"record_key_fields\":[\"LFM1.LIFNR\",\"LFM1.EKORG\"],\"population_excluded\":{\"deleted\":1},\"failing_record_count\":1,\"sample_failing_records\":[{\"LFM1.EKORG\":\"1000\",\"LFM1.INCO1\":\"\",\"LFM1.INCO2\":\"Durban\",\"LFM1.LIFNR\":\"V3\",\"record_key\":\"LIFNR=V3|EKORG=1000\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"POs are created without delivery terms; freight and risk transfer are undefined.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"INCO2 is the named place of the Incoterm in INCO1. A place without an Incoterm is never copied into the purchase order on its own, so the delivery terms the buyer agreed are silently lost.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"LFM1.LIFNR\",\"record_id\":\"V3\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Vendor V3, purchasing organisation 1000: Incoterms location 'Durban' has no Incoterm.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"1b4e701f-4bc2-47eb-a85b-4c5cbe00ebb9\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP074\",\"severity\":\"medium\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":15,\"pass_rate\":93.33,\"details\":{\"message\":\"Open vendor item sits on a reconciliation account other than the vendor's current one\",\"semantics\":\"fail_when\",\"expression\":\"`BSIK.HKONT`.notna() & `LFB1.AKONT`.notna() & (`BSIK.HKONT` != `LFB1.AKONT`)\",\"field_checked\":\"BSIK.HKONT\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"BSIK.HKONT\",\"LFB1.AKONT\",\"LFB1.AKONT\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000112\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.HKONT\":\"0000160090\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.ZUONR\":\"SI-78007\",\"LFB1.AKONT\":\"0000160000\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=SI-78007|GJAHR=2026|BELNR=5100000112|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Balance-sheet reporting and the sub-ledger/G/L reconciliation (FAGLF03) show the balance under the wrong account; regrouping (FAGLF101) uses the wrong account.\",\"rule_authority\":\"best_practice\",\"why_it_matters\":\"Normal vendor items post to the reconciliation account in the company-code master (LFB1.AKONT). When that account is changed, items posted before keep the old one, so the vendor balance is split across reconciliation accounts until they are cleared or reposted.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V1 document 5100000112/2026 item 001 is on account 0000160090; master says 0000160000.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"9688ee40-0095-404d-ab32-e62f579490f3\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP076\",\"severity\":\"medium\",\"dimension\":\"completeness\",\"affected_count\":1,\"total_count\":18,\"pass_rate\":94.44,\"details\":{\"message\":\"Open vendor item has no baseline date for payment\",\"field_checked\":\"BSIK.ZFBDT\",\"id_field_used\":\"BSIK.BUKRS\",\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000114\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.ZFBDT\":\"00000000\",\"BSIK.ZUONR\":\"SI-78011\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=SI-78011|GJAHR=2026|BELNR=5100000114|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Payment run (F110) and dunning (F150) cannot schedule the item; ageing reports misplace it.\",\"rule_authority\":\"sap_hard_constraint\",\"why_it_matters\":\"The due date and every cash-discount date are computed from the baseline date. Without it the item has no due date.\"},\"value_fix_map\":{},\"record_fixes\":[{\"id_field\":\"BSIK.BUKRS\",\"record_id\":\"1000\",\"invalid_value\":\"\",\"sql_statement\":null,\"fix_instruction\":\"Open item 1000/V1 document 5100000114/2026 item 001 has no baseline date.\"}],\"created_at\":\"2026-10-02T05:09:21.146324+00:00\",\"business_name\":null,\"glossary_term_id\":null,\"business_definition\":null},{\"id\":\"43b9117f-98cc-42d5-a580-e8b14ec6942c\",\"version_id\":\"65988d5a-0243-4f9b-bdff-52779e71c6ed\",\"module\":\"accounts_payable\",\"check_id\":\"AP078\",\"severity\":\"medium\",\"dimension\":\"consistency\",\"affected_count\":1,\"total_count\":18,\"pass_rate\":94.44,\"details\":{\"message\":\"Open vendor item's payment-term days are out of order\",\"semantics\":\"fail_when\",\"expression\":\"((`BSIK.ZBD2T` > 0) & (`BSIK.ZBD2T` < `BSIK.ZBD1T`)) | ((`BSIK.ZBD3T` > 0) & (`BSIK.ZBD3T` < `BSIK.ZBD2T`))\",\"field_checked\":\"BSIK.ZBD2T\",\"id_field_used\":\"BSIK.BUKRS\",\"fields_checked\":[\"BSIK.ZBD2T\",\"BSIK.ZBD1T\",\"BSIK.ZBD3T\",\"BSIK.ZBD3T\"],\"record_key_fields\":[\"BSIK.BUKRS\",\"BSIK.LIFNR\",\"BSIK.UMSKS\",\"BSIK.UMSKZ\",\"BSIK.AUGDT\",\"BSIK.AUGBL\",\"BSIK.ZUONR\",\"BSIK.GJAHR\",\"BSIK.BELNR\",\"BSIK.BUZEI\"],\"failing_record_count\":1,\"sample_failing_records\":[{\"BSIK.AUGBL\":\"\",\"BSIK.AUGDT\":\"00000000\",\"BSIK.BELNR\":\"5100000116\",\"BSIK.BUKRS\":\"1000\",\"BSIK.BUZEI\":\"001\",\"BSIK.GJAHR\":\"2026\",\"BSIK.LIFNR\":\"V1\",\"BSIK.UMSKS\":\"\",\"BSIK.UMSKZ\":\"\",\"BSIK.ZBD1T\":\"30\",\"BSIK.ZBD2T\":\"14\",\"BSIK.ZBD3T\":\"0\",\"BSIK.ZUONR\":\"SI-78019\",\"record_key\":\"BUKRS=1000|LIFNR=V1|UMSKS=|UMSKZ=|AUGDT=00000000|AUGBL=|ZUONR=SI-78019|GJAHR=2026|BELNR=5100000116|BUZEI=001\"}]},\"remediation_text\":null,\"rule_context\":{\"sap_impact\":\"Discount is taken after