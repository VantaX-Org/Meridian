# =========================================================
# Meridian Ollama — Pre-baked model image (Tier 2)
# Build arg MODEL_NAME selects the bundled model
# =========================================================

FROM ollama/ollama:latest

# qwen3.5:9b-instruct was never a real Ollama model — the "-instruct" suffix
# doesn't exist for this family. `ollama pull` failed on it every time this
# was built, but the old `|| true` below swallowed that failure, so the
# build reported success and published an image with zero model blobs
# baked in (confirmed at runtime: "total blobs: 0"). qwen3.5:9b is the real,
# pullable tag.
ARG MODEL_NAME=qwen3.5:9b
ENV MODEL_NAME=${MODEL_NAME}

# Pull the model at build time so customers don't need internet access.
# No `|| true` anywhere in this chain — if the server never comes up, the
# pull fails, or the model isn't actually present afterward, the RUN
# instruction exits non-zero and the build fails loudly instead of
# publishing an empty image that looks fine until a customer tries to use it.
# curl isn't in this base image — confirmed at runtime ("executable file
# not found in $PATH"). It was never actually verified here either: the
# `for` loop's exit status is whatever the LAST command run inside it
# returned, which on a full 30-iteration timeout is `sleep 1` (always 0),
# not curl's — so this proceeded silently even when curl failed every single
# time. `ollama list` uses the same binary already running as the server.
RUN ollama serve & \
    for i in $(seq 1 30); do ollama list >/dev/null 2>&1 && break; sleep 1; done && \
    ollama pull "${MODEL_NAME}" && \
    ollama list | grep -qF "${MODEL_NAME}" && \
    pkill ollama

EXPOSE 11434
CMD ["serve"]
