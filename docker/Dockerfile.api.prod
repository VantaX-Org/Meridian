# =========================================================
# Meridian API — Production Image (IP-Protected)
# Multi-stage build: compiles Python to .pyc, strips source
# =========================================================

# === BUILD STAGE ===
FROM python:3.12-slim-bookworm AS builder

# Install system dependencies needed at build time
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libffi-dev \
    libcairo2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

ARG INSTALL_PYRFC=false

# Optional customer-supplied SAP NW RFC SDK (SAP-licensed binary — cannot ship
# in this repo). Drop it into vendor/nwrfcsdk/ before building with
# INSTALL_PYRFC=true. See docs/sap-connector.md.
COPY vendor/nwrfcsdk/ /opt/nwrfcsdk/
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

# Install Python dependencies first (layer cache)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "$INSTALL_PYRFC" = "true" ]; then pip install --no-cache-dir "pyrfc>=3.1.0"; fi

# Copy application source
COPY api/ api/
COPY llm/ llm/
COPY sap/ sap/
COPY workers/ workers/
COPY db/ db/
COPY agents/ agents/
COPY checks/ checks/
COPY templates/ templates/

# Compile all Python source to .pyc bytecode (exclude migrations - they must stay as .py)
RUN python -m compileall -b -f \
        api/ llm/ sap/ workers/ agents/ checks/ \
    && echo "Compilation complete"

# Strip all .py source (db/migrations excluded — Alembic needs real source
# there). __init__.py is NOT special-cased: it used to be kept-but-truncated
# to an empty stub instead of deleted, which silently broke every package
# whose __init__.py carries real logic (e.g. sap/__init__.py's get_connector()
# dispatch) — Python's import system prefers a present, even empty, .py file
# over the sibling compiled __init__.pyc sitting right next to it. Deleting it
# outright removes the same docstring IP and lets the already-working
# sourceless-import mechanism (proven by every other module here) load the
# compiled bytecode instead.
RUN find . -path "./db/migrations" -prune -o -name "*.py" -type f -delete && \
    find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# === PRODUCTION STAGE ===
FROM python:3.12-slim-bookworm

# Install runtime system dependencies (WeasyPrint, curl for healthcheck, postgresql-client for migrations)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    postgresql-client \
    libpango1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Baked at build time from the CI-computed release tag — never overridable via
# .env, so it's a trustworthy source of "what version is this actually running"
# for the self-update check (api/services/version.py).
ARG MERIDIAN_VERSION=0.0.0-dev
RUN echo "$MERIDIAN_VERSION" > /app/VERSION

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# SAP NW RFC SDK runtime libraries (present only if INSTALL_PYRFC=true was set above)
COPY --from=builder /opt/nwrfcsdk /opt/nwrfcsdk
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

# Copy compiled application (no .py source)
COPY --from=builder /build .

# Copy alembic.ini for migrations (needed by installer)
COPY alembic.ini /app/

# Remove any stray development artifacts (preserve db/migrations/*.py for Alembic)
RUN find . -path "./db/migrations" -prune -o -name "*.py" ! -name "__init__.py" -type f -delete 2>/dev/null || true && \
    find . -name ".git" -type d -exec rm -rf {} + 2>/dev/null || true && \
    find . -name "Makefile" -delete 2>/dev/null || true

# User management CLI (needs source .py, not compiled)
COPY scripts/manage_users.py /app/scripts/manage_users.py

# Copy entrypoint script that runs migrations
COPY docker/entrypoint.api.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["/app/entrypoint.sh"]
