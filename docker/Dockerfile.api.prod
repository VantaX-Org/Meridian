# =========================================================
# Meridian API — Production Image (IP-Protected)
# Multi-stage build: compiles Python to .pyc, strips source
# =========================================================

# === BUILD STAGE ===
FROM python:3.12-slim-bookworm AS builder

# Install system dependencies needed at build time
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libffi-dev \
    libcairo2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

ARG INSTALL_PYRFC=false

# Optional customer-supplied SAP NW RFC SDK (SAP-licensed binary — cannot ship
# in this repo). Drop it into vendor/nwrfcsdk/ before building with
# INSTALL_PYRFC=true. See docs/sap-connector.md.
COPY vendor/nwrfcsdk/ /opt/nwrfcsdk/
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

# Install Python dependencies first (layer cache)
COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock \
    && if [ "$INSTALL_PYRFC" = "true" ]; then pip install --no-cache-dir "pyrfc>=3.1.0"; fi

# Copy application source
COPY api/ api/
COPY llm/ llm/
COPY sap/ sap/
COPY workers/ workers/
COPY db/ db/
COPY agents/ agents/
COPY checks/ checks/
COPY templates/ templates/
# the guide's chapters (the help panel shows them; the API renders them as the PDF manual)
COPY frontend/docs/guide/ docs/guide/
# the guide's recordings (the help panel plays them; the API serves them)
COPY frontend/docs/help-videos/ docs/help-videos/

# Compile all Python source to .pyc bytecode beside the source (-b), so the
# sourceless loader finds module.pyc and package __init__.pyc once the .py is
# gone. db/migrations is excluded: Alembic loads revision files by path and
# needs real source there.
RUN python -m compileall -b -f -q -x 'db/migrations/' \
        api/ llm/ sap/ workers/ db/ agents/ checks/ \
    && echo "Compilation complete"

# Strip all .py source except db/migrations. __init__.py is NOT special-cased:
# Python prefers a present, even empty, .py over the sibling compiled .pyc, so
# keeping a stub would break packages whose __init__.py carries real logic
# (e.g. sap/__init__.py's get_connector() dispatch).
RUN find . -name "*.py" -not -path "./db/migrations/*" -delete \
    && find . -name "__pycache__" -type d -prune -exec rm -rf {} +

# Fail the build if any source outside db/migrations survived the strip.
RUN ! find . -name "*.py" -not -path "./db/migrations/*" | grep .

# === PRODUCTION STAGE ===
FROM python:3.12-slim-bookworm

# Install runtime system dependencies (WeasyPrint, curl for healthcheck, postgresql-client for migrations)
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    curl \
    postgresql-client \
    libpango1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Baked at build time from the CI-computed release tag — never overridable via
# .env, so it's a trustworthy source of "what version is this actually running"
# for the self-update check (api/services/version.py).
ARG MERIDIAN_VERSION=0.0.0-dev
RUN echo "$MERIDIAN_VERSION" > /app/VERSION

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# SAP NW RFC SDK runtime libraries (present only if INSTALL_PYRFC=true was set above)
COPY --from=builder /opt/nwrfcsdk /opt/nwrfcsdk
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

# Copy compiled application (no .py source)
COPY --from=builder /build .

# Copy alembic.ini for migrations (needed by installer)
COPY alembic.ini /app/

# Remove any stray development artifacts, then prove the image carries no
# application source (db/migrations stays: Alembic needs it).
RUN find . -name ".git" -type d -prune -exec rm -rf {} + \
    && find . -name "Makefile" -delete \
    && ! find . -name "*.py" -not -path "./db/migrations/*" | grep .

# User management CLI (needs source .py, not compiled)
COPY scripts/manage_users.py /app/scripts/manage_users.py

# Copy entrypoint script that runs migrations
COPY docker/entrypoint.api.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# This release's deployment files. scripts/update.sh copies them onto the host
# after pulling, so an update delivers its own compose/script changes — not
# only new images. Plain config, no application source.
COPY docker/docker-compose.customer.yml docker/docker-compose.customer.ollama.yml docker/docker-compose.updater.yml docker/Dockerfile.rfc /deploy/docker/
COPY docker/nginx/meridian.conf docker/nginx/nginx.conf /deploy/docker/nginx/
COPY scripts/update.sh scripts/build-rfc-overlay.sh scripts/preflight.sh scripts/backup.sh scripts/restore.sh scripts/enable-local-ai.sh scripts/nginx-https.sh /deploy/scripts/

ENV PYTHONPATH=/app

EXPOSE 8000
CMD ["/app/entrypoint.sh"]
