# MinIO object storage, built from its public source and published as
# ghcr.io/vantax-org/meridian-minio, so deployments never depend on a third-party
# registry (quay.io refuses anonymous pulls).
#
# MinIO is AGPL-3.0: the server source is unmodified; its licence and notice
# are shipped under /licenses. The build uses a current Go toolchain and raises
# third-party Go modules to their fixed releases (verified with govulncheck and
# the Trivy image scan); advisories without a published fix remain upstream's.
FROM golang:1.26-alpine AS build
ARG MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
RUN apk add --no-cache git
RUN git clone --depth 1 --branch "${MINIO_TAG}" https://github.com/minio/minio.git /src
WORKDIR /src
# dependency security fixes (minimum fixed versions; Go resolves the rest)
RUN go get \
      filippo.io/edwards25519@v1.1.1 \
      github.com/Azure/go-ntlmssp@v0.1.1 \
      github.com/apache/thrift@v0.24.0 \
      github.com/buger/jsonparser@v1.1.2 \
      github.com/eclipse/paho.mqtt.golang@v1.5.1 \
      github.com/go-jose/go-jose/v4@v4.1.4 \
      github.com/klauspost/compress@v1.18.7 \
      github.com/prometheus/prometheus@v0.311.3 \
      github.com/rabbitmq/amqp091-go@v1.13.0 \
      go.etcd.io/etcd/client/pkg/v3@v3.5.33 \
      golang.org/x/crypto@v0.56.0 \
      google.golang.org/grpc@v1.83.2
# MINIO_RELEASE=RELEASE stamps the release version (as upstream's Makefile does)
RUN CGO_ENABLED=0 go build -mod=mod -trimpath \
      -ldflags "$(MINIO_RELEASE=RELEASE go run -mod=mod buildscripts/gen-ldflags.go) -s -w" -o /out/minio .

FROM alpine:3.22
ARG MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
LABEL org.opencontainers.image.title="meridian-minio" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.version="${MINIO_TAG}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
# curl: the compose healthcheck probes /minio/health/live; sh/tar: backup.sh / restore.sh
RUN apk add --no-cache ca-certificates curl && mkdir -p /data /licenses
COPY --from=build /out/minio /usr/bin/minio
COPY --from=build /src/LICENSE /licenses/MINIO-LICENSE
COPY --from=build /src/NOTICE /licenses/MINIO-NOTICE
# root, like the upstream image: existing minio_data volumes were written as root
EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
