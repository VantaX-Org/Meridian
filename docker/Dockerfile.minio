# MinIO object storage, built from its public source at a pinned release and
# published as ghcr.io/vantax-org/meridian-minio, so customer deployments never
# depend on a third-party registry (quay.io now refuses anonymous pulls).
#
# MinIO is AGPL-3.0: this image ships the unmodified server built from the
# upstream tag below, with its licence under /licenses. Bump MINIO_TAG to
# upgrade (keep docker-compose*.yml / helm values on the same Meridian tag).
FROM golang:1.23-alpine AS build
ARG MINIO_TAG=RELEASE.2024-11-07T00-52-20Z
RUN apk add --no-cache git
RUN git clone --depth 1 --branch "${MINIO_TAG}" https://github.com/minio/minio.git /src
WORKDIR /src
# MINIO_RELEASE=RELEASE stamps the release version (as upstream's Makefile does)
RUN CGO_ENABLED=0 go build -trimpath \
      -ldflags "$(MINIO_RELEASE=RELEASE go run buildscripts/gen-ldflags.go) -s -w" -o /out/minio .

FROM alpine:3.20
ARG MINIO_TAG=RELEASE.2024-11-07T00-52-20Z
LABEL org.opencontainers.image.title="meridian-minio" \
      org.opencontainers.image.source="https://github.com/minio/minio" \
      org.opencontainers.image.version="${MINIO_TAG}" \
      org.opencontainers.image.licenses="AGPL-3.0-only"
# curl: the compose healthcheck probes /minio/health/live
RUN apk add --no-cache ca-certificates curl && mkdir -p /data /licenses
COPY --from=build /out/minio /usr/bin/minio
COPY --from=build /src/LICENSE /licenses/MINIO-LICENSE
COPY --from=build /src/NOTICE /licenses/MINIO-NOTICE
# root, like the upstream image: existing minio_data volumes were written as root
EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
