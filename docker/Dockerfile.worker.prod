# =========================================================
# Meridian Worker — Production Image (IP-Protected)
# Same build as API, Celery entrypoint
# =========================================================

# === BUILD STAGE ===
FROM python:3.14-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libffi-dev \
    libcairo2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

ARG INSTALL_PYRFC=false

# Optional customer-supplied SAP NW RFC SDK (SAP-licensed binary — cannot ship
# in this repo). Drop it into vendor/nwrfcsdk/ before building with
# INSTALL_PYRFC=true. See docs/sap-connector.md.
COPY vendor/nwrfcsdk/ /opt/nwrfcsdk/
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "$INSTALL_PYRFC" = "true" ]; then pip install --no-cache-dir "pyrfc>=3.1.0"; fi

COPY api/ api/
COPY llm/ llm/
COPY sap/ sap/
COPY workers/ workers/
COPY db/ db/
COPY agents/ agents/
COPY checks/ checks/
COPY templates/ templates/

# Compile to .pyc and strip source. __init__.py is NOT special-cased — see
# Dockerfile.api.prod for why keeping-but-truncating it breaks packages whose
# __init__.py carries real logic (sap/__init__.py's get_connector(), etc.):
# Python prefers a present, even empty, .py over the sibling compiled .pyc.
# db/migrations is excluded — Alembic needs real source there.
RUN python -m compileall -b -f \
        api/ llm/ sap/ workers/ db/ agents/ checks/ \
    && find . -path "./db/migrations" -prune -o -name "*.py" -type f -delete && \
    find . -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true

# === PRODUCTION STAGE ===
FROM python:3.14-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libpango1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# SAP NW RFC SDK runtime libraries (present only if INSTALL_PYRFC=true was set above)
COPY --from=builder /opt/nwrfcsdk /opt/nwrfcsdk
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

COPY --from=builder /build .

RUN find . -name "*.py" ! -name "__init__.py" -delete 2>/dev/null || true

ENV PYTHONPATH=/app

CMD ["celery", "-A", "workers.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
