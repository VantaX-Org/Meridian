# =========================================================
# Meridian Worker — Production Image (IP-Protected)
# Same build as API, Celery entrypoint
# =========================================================

# === BUILD STAGE ===
FROM python:3.12-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpango1.0-dev \
    libgdk-pixbuf-2.0-dev \
    libffi-dev \
    libcairo2-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

ARG INSTALL_PYRFC=false

# Optional customer-supplied SAP NW RFC SDK (SAP-licensed binary — cannot ship
# in this repo). Drop it into vendor/nwrfcsdk/ before building with
# INSTALL_PYRFC=true. See docs/sap-connector.md.
COPY vendor/nwrfcsdk/ /opt/nwrfcsdk/
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

COPY requirements.txt requirements.lock ./
RUN pip install --no-cache-dir -r requirements.txt -c requirements.lock \
    && if [ "$INSTALL_PYRFC" = "true" ]; then pip install --no-cache-dir "pyrfc>=3.1.0"; fi

COPY api/ api/
COPY llm/ llm/
COPY sap/ sap/
COPY workers/ workers/
COPY db/ db/
COPY agents/ agents/
COPY checks/ checks/
COPY templates/ templates/

# Compile to .pyc beside the source (-b) and strip the source. __init__.py is
# NOT special-cased: see Dockerfile.api.prod for why keeping a stub breaks
# packages whose __init__.py carries real logic (sap/__init__.py's
# get_connector(), etc.). db/migrations is excluded: Alembic needs real source.
RUN python -m compileall -b -f -q -x 'db/migrations/' \
        api/ llm/ sap/ workers/ db/ agents/ checks/ \
    && find . -name "*.py" -not -path "./db/migrations/*" -delete \
    && find . -name "__pycache__" -type d -prune -exec rm -rf {} +

# Fail the build if any source outside db/migrations survived the strip.
RUN ! find . -name "*.py" -not -path "./db/migrations/*" | grep .

# === PRODUCTION STAGE ===
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    curl \
    libpango1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# SAP NW RFC SDK runtime libraries (present only if INSTALL_PYRFC=true was set above)
COPY --from=builder /opt/nwrfcsdk /opt/nwrfcsdk
ENV SAPNWRFC_HOME=/opt/nwrfcsdk
ENV LD_LIBRARY_PATH=/opt/nwrfcsdk/lib:${LD_LIBRARY_PATH}

COPY --from=builder /build .

# The same version stamp the API image carries (docker/Dockerfile.api.prod), so preflight can
# prove the worker runs the release the API does. Without it the worker reports the 0.0.0-dev
# source fallback and the only evidence of a matching deploy is the rule-pack hash - which would
# not notice a half-finished rollout where the worker kept the previous image.
ARG MERIDIAN_VERSION=0.0.0-dev
RUN echo "$MERIDIAN_VERSION" > /app/VERSION

# Prove the final image carries no application source (db/migrations stays).
RUN ! find . -name "*.py" -not -path "./db/migrations/*" | grep .

ENV PYTHONPATH=/app

CMD ["celery", "-A", "workers.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
