# =========================================================
# Meridian Platform — Environment Configuration Reference
# Copy to .env and fill in your values.
# =========================================================

# ── Internal API proxy (used by Next.js rewrites — do not change) ─────────────
# The frontend proxies /api/* to this URL over the Docker network.
INTERNAL_API_URL=http://api:8000

# ── Licence ───────────────────────────────────────────────────────────────────
# Mode: 'online' (default) phones home to the licence server every 6 hours.
# Mode: 'offline' uses a pre-signed JWT token — for air-gapped deployments.
# MERIDIAN_ENV=production                     # only 'development' runs without a licence key
MERIDIAN_LICENCE_MODE=online
MERIDIAN_LICENCE_KEY=                        # issued by Meridian HQ (online mode)
MERIDIAN_LICENCE_TOKEN=                      # signed JWT from Meridian HQ (offline mode only)
MERIDIAN_LICENCE_SERVER_URL=https://licence.meridian.vantax.co.za/api/licence/validate
# Public key for offline token verification (baked into production image):
MERIDIAN_OFFLINE_PUBLIC_KEY=
# RSA public key (PEM) that verifies the online licence-validate response signature.
# UNSET = enforcement off (responses accepted as before — safe default during rollout).
# SET = a forged/replayed/cross-node `valid:true` is rejected. Enable only after the
# signing worker is live. See cloudflare/licence-worker/DEPLOY_RUNBOOK.md.
LICENCE_SERVER_PUBLIC_KEY=
# LICENCE_SIGNATURE_MAX_AGE_SECONDS=604800   # replay window for a signed response (default 7d)

# ── Self-update sidecar ───────────────────────────────────────────────────────
# Lets admins trigger a one-click platform update from the app (Admin >
# Licence tab). Auto-generated by meridian-deploy.sh / create-customer-package.sh
# for new installs; existing deployments can retrofit it with
# scripts/enable-auto-update.sh. Leave UPDATER_SHARED_SECRET blank to disable
# the feature (the UI degrades gracefully — no button shown).
UPDATER_URL=http://updater:8080
UPDATER_SHARED_SECRET=                       # must match the updater container's own env var

# ── LLM — choose one tier ─────────────────────────────────────────────────────
# Tier 0 — LLM-less (fully deterministic; no Ollama container, no cloud LLM):
#   All SAP checks, matching, survivorship, triage and impact scoring run
#   deterministically. The four MERIDIAN_*_LLM flags below are auto-honoured
#   because safe_invoke short-circuits when LLM_PROVIDER=none.
#   Use this mode for bulk 400k-record loads, air-gapped sites without GPU, or
#   proof-of-concept deployments with no LLM budget.
# LLM_PROVIDER=none
#
# Tier 1 — Cloud API (Anthropic or Azure OpenAI):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6          # optional override
#
# Tier 1 (Azure alternative):
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
#
# Tier 1.5 — Ollama Cloud (recommended for small tenants — sanitised prompts
# only leave the cluster; all SAP data, findings and reports stay on-prem):
# LLM_PROVIDER=ollama_cloud
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=                            # from https://ollama.com/settings
# OLLAMA_MODEL=deepseek-v3.1:671b-cloud
#
# Tier 2 — Bundled Ollama (local container, full residency, needs GPU or slow):
# Default. On an installed server: sudo bash scripts/enable-local-ai.sh
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3.5:9b
#
# Tier 3 — BYOLLM (any OpenAI-compatible endpoint):
# LLM_PROVIDER=custom
# CUSTOM_LLM_BASE_URL=https://your-llm.internal:8080/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=

# Key-encryption key for tenant-stored LLM API keys (Fernet). REQUIRED if any
# tenant stores a cloud-LLM key via the UI — without it those keys can't be
# decrypted and LLM calls silently fail. Generate: python -c "from
# cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_KEK=

# ── LLM reduction feature flags ──────────────────────────────────────────────
# Each of the four AI services honours its own flag. Default is "on" — the
# deterministic layer still runs first, LLM only fires on the uncertain band.
# Flip to "off" to force fully-deterministic behaviour per service (useful for
# 400k bulk ingests where LLM latency is the bottleneck).
# MERIDIAN_SEMANTIC_MATCHER_LLM=on
# MERIDIAN_SURVIVORSHIP_LLM=on
# MERIDIAN_TRIAGE_LLM=on
# MERIDIAN_IMPACT_SCORER_LLM=on

# ── Database ──────────────────────────────────────────────────────────────────
# Connection strategy (two roles, defense-in-depth for RLS):
#   meridian       — schema owner, used ONLY by Alembic migrations.
#   meridian_app   — non-superuser, NOBYPASSRLS; used by the API + workers.
#                    Migration 040 creates it from MERIDIAN_APP_PASSWORD below.
#                    Because it's non-superuser, FORCE RLS actually applies —
#                    forgetting to SET app.tenant_id returns zero rows
#                    instead of silently leaking data across tenants.
DB_PASSWORD=password                         # meridian owner password — change in production
MERIDIAN_APP_PASSWORD=app-password           # meridian_app password — change in production
DATABASE_URL=postgresql+asyncpg://meridian_app:${MERIDIAN_APP_PASSWORD}@db:5432/meridian
DATABASE_URL_SYNC=postgresql://meridian_app:${MERIDIAN_APP_PASSWORD}@db:5432/meridian
DATABASE_URL_MIGRATE=postgresql://meridian:${DB_PASSWORD}@db:5432/meridian
# API connection pool (one connection per request in flight). Raise POOL_SIZE and MAX_OVERFLOW
# together if the API logs "QueuePool limit ... reached"; keep their sum below the Postgres
# max_connections left after the workers. POOL_TIMEOUT is the seconds a request waits for a
# free connection before failing.
MERIDIAN_DB_POOL_SIZE=20
MERIDIAN_DB_MAX_OVERFLOW=20
MERIDIAN_DB_POOL_TIMEOUT=30

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_ENDPOINT=minio:9000                    # Garage object storage (service 'storage', alias 'minio')
MINIO_ACCESS_KEY=meridian
MINIO_PASSWORD=change-me-at-least-16-chars  # Garage requires 16+ characters; deploy generates one
MINIO_BUCKET_UPLOADS=meridian-uploads
MINIO_BUCKET_REPORTS=meridian-reports

# ── Auth ──────────────────────────────────────────────────────────────────────
# local = built-in auth (default for customer deployments)
# clerk = Clerk.dev (used on Meridian HQ portal only)
AUTH_MODE=local
CLERK_SECRET_KEY=                            # only for AUTH_MODE=clerk

# ── Initial setup ─────────────────────────────────────────────────────────────
INITIAL_TENANT_NAME=                         # first tenant created by install.sh

# ── SAP RFC Sync ──────────────────────────────────────────────────────────────

CREDENTIAL_MASTER_KEY=                       # AES-256 key for SAP credential encryption
SAP_RFC_USER=RFC_USER                        # SAP technical user for RFC connections

# INSTALL_PYRFC=true bakes pyrfc + the SAP NW RFC SDK into the built image.
# Only takes effect if you build locally (docker-compose.build.yml) AND have
# dropped the SDK into vendor/nwrfcsdk/ first — see docs/sap-connector.md.
# Not used when pulling the prebuilt ghcr.io image.
INSTALL_PYRFC=false

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                              # or configure SMTP below for air-gapped
TEAMS_WEBHOOK_URL=                           # optional Teams webhook

# ── SMTP (air-gapped deployments — alternative to Resend) ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@meridian.local

# ── Microsoft Graph API (for email via Azure) ─────────────────────────────────
MICROSOFT_TENANT_ID=                         # Azure tenant ID
MICROSOFT_CLIENT_ID=                         # Azure app registration client ID
MICROSOFT_CLIENT_SECRET=                     # Azure app registration client secret
EMAIL_FROM=noreply@meridian.local            # Email address to send from

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                                  # optional Sentry error tracking

# ── Long-running jobs ─────────────────────────────────────────────────────────
# Ceiling for one analysis run (checks + the cross-run issue lifecycle), in seconds.
# Default 24 h (86400). The tail of a run is the issue lifecycle, whose cost scales
# with the accumulated record_issues of the system, not with the rules: on the
# A pilot sandbox SuccessFactors finished it in ~2 minutes, while the ECC system
# (2.78M issues) needed over 5 h 50 m. Raise this only if your largest object still
# reaches it. A run killed by the limit is recorded, not lost: finished modules keep
# their scores and the rest are marked missing.
# MERIDIAN_CHECKS_TIME_LIMIT=86400
#
# How many analyses may run at once, across all workers. Each holds a full dataset in
# memory, so raise it only with the RAM to match (a material-master run peaked around
# 13.5 GB). Default 1.
# MERIDIAN_CHECKS_SLOTS=1
#
# Ceiling for one extraction over RFC (default 24 h).
# MERIDIAN_EXTRACT_TIME_LIMIT=86400
#
# Retention and purge. The policy itself is set in Admin > Settings > Retention.
# The nightly task (02:30 UTC) only writes dry-run rows to the purge log until this
# is "true" AND the tenant has at least seven days of dry runs behind it. Leave it
# unset to keep every run for ever (archiving still hides old runs).
# MERIDIAN_PURGE_ENABLED=false

# ── Meridian 2 (steps 8 to 10) ───────────────────────────────────────────────
# Address people open Meridian at. Links in digests, webhooks, invitations and
# password resets start with it; without it they fall back to SERVER_DOMAIN.
# MERIDIAN_APP_URL=https://meridian.example.com
#
# SCIM provisioning, the brand theme, webhooks, scheduled digests, sandbox mode
# and the run cost model (run_cost) are tenant settings, not environment
# variables: Administration > Users (SCIM token and group mappings),
# Administration > Settings (appearance, cost model with run_cost, sandbox),
# Administration > Webhooks and Administration > Digests. They are all off or
# empty until an administrator sets them. Digests sent by email use
# the SMTP_* or Microsoft Graph settings above; with neither set, email is
# skipped and the delivery is recorded as failed with the reason.
#
# Questions in plain words on the command line are parsed by fixed tables. Set
# to 1 to let the configured LLM map only the words the tables do not know onto
# the same filters (the model never sees SAP data; calls go to llm_audit_log).
# MERIDIAN_NL_LLM=0
#
# Status page: the Celery queues it watches and the backlog that turns a queue
# amber.
# MERIDIAN_STATUS_QUEUES=celery
# MERIDIAN_STATUS_QUEUE_WARN=100
#
# Fix simulation: how long a simulation result is kept (seconds) and the
# ceiling for one simulation task.
# MERIDIAN_SIMULATION_TTL=86400
# MERIDIAN_SIMULATION_TIME_LIMIT=3600
#
# Delta extraction: a delta run falls back to a full extraction when the last
# full one is older than this many days.
# MERIDIAN_DELTA_FULL_DAYS=7
